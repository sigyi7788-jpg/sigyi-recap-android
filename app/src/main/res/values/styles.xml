<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/sigyi_accent</item>
        <item name="android:navigationBarColor">@color/sigyi_background</item>
        <item name="android:statusBarColor">@color/sigyi_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="SigyiSectionLabel" parent="android:style/Widget.TextView">
        <item name="android:textColor">@color/sigyi_accent</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <style name="SigyiPrimaryButton" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/sigyi_background</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="SigyiAccentButton" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_button_accent</item>
        <item name="android:textColor">@color/sigyi_background</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
