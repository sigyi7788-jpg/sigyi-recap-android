<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sigyi_background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SIGYI AI"
                    android:textColor="@color/sigyi_accent"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.16" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Recap Studio"
                    android:textColor="@color/sigyi_text_primary"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/connectionBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:text="●  READY"
                android:textColor="@color/sigyi_success"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Foreign movie ကို မြန်မာလို recap script, voice နဲ့ short video အဖြစ် ပြောင်းပါ။"
            android:textColor="@color/sigyi_text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_hero"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR NEXT RECAP"
                android:textColor="@color/sigyi_lavender"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="One video.\nOne powerful story."
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="AI က story ကိုနားလည်ပြီး မြန်မာလို သဘာဝကျကျ ပြန်ပြောပေးမယ်။"
                android:textColor="#D8D6E8"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            style="@style/SigyiSectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="01  SOURCE VIDEO" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/videoName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Video မရွေးရသေးပါ"
                android:textColor="@color/sigyi_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/videoMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="MP4, MOV, MKV • ဖုန်းထဲက video ကိုရွေးပါ"
                android:textColor="@color/sigyi_text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/chooseVideoButton"
                style="@style/SigyiPrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="＋  Video Import လုပ်ရန်" />
        </LinearLayout>

        <TextView
            style="@style/SigyiSectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="02  AI BRAIN" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gemini API Key"
                android:textColor="@color/sigyi_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/apiKeyInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="AIza... API key ထည့်ပါ"
                android:inputType="textPassword"
                android:padding="14dp"
                android:textColor="@color/sigyi_text_primary"
                android:textColorHint="@color/sigyi_text_muted"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/modelSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input"
                android:entries="@array/gemini_models"
                android:padding="12dp" />

            <Button
                android:id="@+id/analyzeButton"
                style="@style/SigyiAccentButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="✦  AI Script ရေးမည်" />
        </LinearLayout>

        <TextView
            style="@style/SigyiSectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="03  MYANMAR SCRIPT" />

        <LinearLayout
            android:id="@+id/scriptCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/scriptStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AI script ထွက်လာရင် ဒီနေရာမှာ ပြင်နိုင်ပါမယ်။"
                android:textColor="@color/sigyi_text_secondary"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/scriptInput"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input"
                android:gravity="top|start"
                android:hint="မြန်မာ recap script..."
                android:inputType="textMultiLine|textCapSentences"
                android:padding="14dp"
                android:textColor="@color/sigyi_text_primary"
                android:textColorHint="@color/sigyi_text_muted"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            style="@style/SigyiSectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="04  VOICE &amp; RENDER" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Myanmar narration voice"
                android:textColor="@color/sigyi_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/voiceSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:entries="@array/myanmar_voices"
                android:padding="12dp" />

            <TextView
                android:id="@+id/speedValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Voice speed 92%"
                android:textColor="@color/sigyi_text_secondary"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/speedSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="42" />

            <TextView
                android:id="@+id/pitchValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Voice pitch 100%"
                android:textColor="@color/sigyi_text_secondary"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/pitchSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="50" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/subtitleCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Subtitle"
                    android:textColor="@color/sigyi_text_secondary" />

                <CheckBox
                    android:id="@+id/replaceAudioCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:checked="true"
                    android:enabled="false"
                    android:text="TTS voice only (original muted)"
                    android:textColor="@color/sigyi_text_secondary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="9:16 • 720p"
                    android:textColor="@color/sigyi_accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/previewVoiceButton"
                style="@style/SigyiAccentButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="♫  Myanmar Voice Preview" />

            <Button
                android:id="@+id/renderButton"
                style="@style/SigyiPrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="▶  FFmpeg.wasm Render စတင်မည်" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="22dp"
            android:progressTint="@color/sigyi_accent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Ready to create your recap"
            android:textColor="@color/sigyi_text_secondary"
            android:textSize="13sp" />

        <WebView
            android:id="@+id/wasmWebView"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
